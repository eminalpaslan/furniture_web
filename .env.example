# ─────────────────────────────────────────────────────────────────────────────
# Ortam değişkenleri — örnek dosya (ARCHITECTURE §13)
#
# Lokal kurulum:  bu dosyayı kökte ".env" adıyla kopyala → `cp .env.example .env`
# Aşağıdaki değerler docker-compose.yml'deki LOKAL servislerle çalışır.
# Gerçek ortamlarda (staging, production) değerler dosyadan değil sunucunun gizli yöneticisinden gelir.
# .env dosyası git'e GİRMEZ (.gitignore). Bu örnek dosyaya ASLA gerçek şifre yazma.
#
# Uygulamalar açılışta değişkenleri Zod ile doğrular; eksik/yanlış bir değer varsa hangisi olduğunu yazıp başlamaz.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ API ve worker (apps/api — src/env.ts) ═══════════════════════════════════

# Çalışma ortamı: development | test | production. Verilmezse development.
NODE_ENV=development

# API'nin dinleyeceği port. Verilmezse 4000.
API_PORT=4000

# PostgreSQL bağlantı adresi: postgresql://KULLANICI:ŞİFRE@SUNUCU:PORT/VERİTABANI  (zorunlu)
DATABASE_URL=postgresql://mobilya:mobilya_dev@localhost:15432/mobilya

# Redis adresi — oturum, oran sınırlama ve iş kuyruğu (BullMQ). TLS için rediss:// (zorunlu)
REDIS_URL=redis://localhost:16379

# Meilisearch arama motoru adresi ve yönetici anahtarı (anahtar en az 16 karakter) (zorunlu)
MEILI_URL=http://localhost:17700
MEILI_MASTER_KEY=mobilya_dev_master_key_32_chars_x

# S3 uyumlu dosya deposu (lokalde RustFS — ADR-006). Ürün görselleri burada saklanır. (zorunlu)
S3_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_ACCESS_KEY=mobilya
# En az 8 karakter.
S3_SECRET_KEY=mobilya_dev_secret
S3_BUCKET=media

# E-posta gönderimi için SMTP sunucusu. Lokalde Mailpit: gönderilen e-postalar http://localhost:18025 adresinde görünür. (zorunlu)
SMTP_HOST=localhost
SMTP_PORT=11025


# ═══ Vitrin ve yönetim paneli (apps/web, apps/admin — env.ts) ═══════════════

# Next.js sunucusunun API'ye ulaşacağı adres (yalnızca sunucu tarafı, tarayıcıya gönderilmez). (zorunlu)
API_URL=http://localhost:4000


# ═══ Docker Compose (yalnızca lokal servisler — docker-compose.yml) ═════════
# Değiştirirsen yukarıdaki bağlantı adreslerini de aynı değerlerle güncelle.

POSTGRES_USER=mobilya
POSTGRES_PASSWORD=mobilya_dev
POSTGRES_DB=mobilya
S3_HOST_PORT=19000
S3_CONSOLE_HOST_PORT=19001
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MEILI_HOST_PORT=17700
SMTP_HOST_PORT=11025
MAILPIT_UI_HOST_PORT=18025
